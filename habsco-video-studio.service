[Unit]
Description=HABSCO Long-Form Video Studio API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/habsco-video-studio
EnvironmentFile=/etc/habsco/video-studio.env
ExecStart=/opt/habsco-video-studio/venv/bin/gunicorn --bind 127.0.0.1:8790 --workers 1 --threads 4 --timeout 3600 video-studio-api:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/habsco-video-studio

[Install]
WantedBy=multi-user.target
