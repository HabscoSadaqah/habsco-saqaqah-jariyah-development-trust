[Unit]
Description=Habsco Utility Payment Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/habsco-utility-gateway
EnvironmentFile=/etc/habsco/utility-gateway.env
ExecStart=/usr/local/bin/deno run --allow-net --allow-env /opt/habsco-utility-gateway/index.ts
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
